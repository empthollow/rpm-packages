#!/bin/bash
# Dell R720 Fan Controller Tool
# Query and control fan speeds, temperatures, and service status

set -euo pipefail

SENSOR_INLET="04h"
SENSOR_CPU1="0Eh"
SENSOR_CPU2="0Fh"
SERVICE_NAME="dellfans"

usage() {
    cat << EOF
Usage: dellfans-tool [OPTION]

Options:
  status        Show service status
  temps         Show current temperatures
  fans          Show fan speeds (RPM)
  logs          Show recent service logs (last 20 lines)
  all           Show all information
  ping          Check if IPMI controller is responsive
  reset         Force a cold reset of the IPMI controller (requires root)
  mode          Show current IPMI fan control mode (manual or factory auto)
  fix-pcie      Disable third-party PCIe fan override (stops iDRAC overriding manual speeds)
  help          Display this help message

Examples:
  dellfans-tool status
  dellfans-tool temps
  dellfans-tool logs -n 50  # Last 50 log lines
  dellfans-tool all
  dellfans-tool ping
  sudo dellfans-tool reset

EOF
    exit 0
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "Error: This command requires root access (run with sudo)"
        exit 1
    fi
}

show_service_status() {
    echo "=== Dellfans Service Status ==="
    systemctl status "$SERVICE_NAME" --no-pager || true
    echo ""
}

show_temps() {
    echo "=== Current Temperatures ==="

    if [[ $EUID -ne 0 ]]; then
        echo "Warning: Root access required (run with sudo)"
        echo ""
        return
    fi

    local inlet=$(ipmitool sdr type temperature 2>/dev/null | grep "$SENSOR_INLET" | cut -d"|" -f5 | awk '{print $1}' || echo "N/A")
    local cpu1=$(ipmitool sdr type temperature 2>/dev/null | grep "$SENSOR_CPU1" | cut -d"|" -f5 | awk '{print $1}' || echo "N/A")
    local cpu2=$(ipmitool sdr type temperature 2>/dev/null | grep "$SENSOR_CPU2" | cut -d"|" -f5 | awk '{print $1}' || echo "N/A")

    echo "Inlet Temp:  ${inlet}°C"
    echo "CPU 1 Temp:  ${cpu1}°C"
    echo "CPU 2 Temp:  ${cpu2}°C"

    if command -v nvidia-smi &> /dev/null; then
        echo ""
        echo "GPU Temperatures:"
        if nvidia-smi --query-gpu=index,name,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | grep -q '^[0-9]'; then
            nvidia-smi --query-gpu=index,name,temperature.gpu --format=csv,noheader,nounits | while IFS=, read -r idx name temp; do
                echo "  GPU $idx ($name): ${temp}°C"
            done
        else
            echo "  Warning: NVIDIA driver not loaded or GPUs not accessible"
        fi
    fi
    echo ""
}

show_fans() {
    echo "=== Fan Speeds (RPM) ==="

    if [[ $EUID -ne 0 ]]; then
        echo "Warning: Root access required (run with sudo)"
        echo ""
        return
    fi

    ipmitool sensor list 2>/dev/null | grep -i "fan" | grep -v "Redundancy" | awk '{print $1, $2, $3}' || echo "Unable to read fan speeds"
    echo ""
}

show_logs() {
    local lines=${1:-20}
    echo "=== Recent Service Logs (last $lines lines) ==="
    journalctl -u "$SERVICE_NAME" -n "$lines" --no-pager || echo "No logs found"
    echo ""
}

show_all() {
    show_service_status
    show_temps
    show_fans
    show_logs 10
}

ping_ipmi() {
    echo "=== IPMI Controller Status ==="

    if [[ $EUID -ne 0 ]]; then
        echo "Warning: Root access required (run with sudo)"
        exit 1
    fi

    echo -n "Checking IPMI responsiveness... "
    if ipmitool mc info &>/dev/null; then
        echo "OK"
        echo ""
        ipmitool mc info
    else
        echo "UNRESPONSIVE"
        echo ""
        echo "IPMI controller is not responding. You may need to run: sudo dellfans-tool reset"
        exit 1
    fi
    echo ""
}

show_fan_mode() {
    require_root

    echo "=== Fan Control Mode ==="

    # iDRAC on R720 does not support reading the manual mode bit via raw command.
    # Use service state as the authoritative source instead.
    local svc_active
    svc_active=$(systemctl is-active "$SERVICE_NAME" 2>/dev/null || true)
    echo "Service:  $svc_active"

    if [[ "$svc_active" == "active" ]]; then
        local last_entry
        last_entry=$(journalctl -u "$SERVICE_NAME" --no-pager -n 200 2>/dev/null \
            | grep -E "Enabled manual fan control|Shutting down|restoring factory auto" \
            | tail -1 || true)

        if echo "$last_entry" | grep -q "Enabled manual fan control"; then
            echo "Mode:     MANUAL (dellfans is controlling fan speeds)"
        elif echo "$last_entry" | grep -q "Shutting down\|restoring factory auto"; then
            echo "Mode:     FACTORY AUTO (service stopped cleanly)"
        else
            echo "Mode:     UNKNOWN (no control state in recent logs)"
        fi
    else
        echo "Mode:     FACTORY AUTO (service is not running)"
    fi

    echo ""

    # Check third-party PCIe cooling response — byte 8 of response is the flag
    # 01 = enabled (iDRAC overriding manual speeds for non-Dell cards like P40)
    # 00 = disabled (manual control respected)
    local pcie_raw
    pcie_raw=$(ipmitool raw 0x30 0xce 0x01 0x16 0x05 0x00 0x00 0x00 2>/dev/null) || pcie_raw=""
    local pcie_byte
    pcie_byte=$(echo "$pcie_raw" | awk '{print $8}' | tr -d ' \n')

    echo "Third-party PCIe fan override: raw='$pcie_raw'"
    if [[ "$pcie_byte" == "01" ]]; then
        echo "  WARNING: ENABLED — iDRAC is overriding manual fan speeds for non-Dell cards (P40)."
        echo "           Run: sudo dellfans-tool fix-pcie"
    elif [[ "$pcie_byte" == "00" ]]; then
        echo "  OK: DISABLED — iDRAC will not override fan speeds for non-Dell cards."
    else
        echo "  UNKNOWN (byte 8: '$pcie_byte')"
    fi
    echo ""
}

force_cold_reset() {
    require_root

    echo "=== IPMI Cold Reset ==="
    echo "Warning: This will reset the IPMI controller. Fan control will be interrupted temporarily."
    echo -n "Sending cold reset command... "

    if ipmitool mc reset cold 2>/dev/null; then
        echo "sent"
    else
        echo "failed"
        echo "Error: Failed to send cold reset command."
        exit 1
    fi

    echo "Waiting for IPMI to reinitialize..."
    local max_wait=60
    local waited=0

    while [[ $waited -lt $max_wait ]]; do
        sleep 2
        waited=$((waited + 2))
        if ipmitool mc info &>/dev/null; then
            echo "IPMI reinitialized after ${waited} seconds."
            echo ""
            echo "IPMI is now responsive. If dellfans service is running, restart it:"
            echo "  sudo systemctl restart $SERVICE_NAME"
            exit 0
        fi
        echo -n "."
    done

    echo ""
    echo "Warning: IPMI did not respond within ${max_wait}s. It may still be initializing."
    exit 1
}

fix_pcie_override() {
    require_root

    echo "=== Disable Third-Party PCIe Fan Override ==="
    echo "Sending command to disable iDRAC third-party PCIe cooling response..."

    if ipmitool raw 0x30 0xce 0x00 0x16 0x05 0x00 0x00 0x00 0x05 0x00 0x00 0x00 0x00 2>/dev/null; then
        echo "Done."
        echo ""
        echo "iDRAC will no longer override manual fan speeds for non-Dell PCIe cards."
        echo "Run 'sudo dellfans-tool mode' to confirm the PCIe response is now disabled."
    else
        echo "Error: Command failed. Check if IPMI is responsive: sudo dellfans-tool ping"
        exit 1
    fi
    echo ""
}

# Parse arguments
case "${1:-help}" in
    status)
        show_service_status
        ;;
    temps)
        show_temps
        ;;
    fans)
        show_fans
        ;;
    logs)
        show_logs "${2:-20}"
        ;;
    all)
        show_all
        ;;
    ping)
        ping_ipmi
        ;;
    reset)
        force_cold_reset
        ;;
    mode)
        show_fan_mode
        ;;
    fix-pcie)
        fix_pcie_override
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown option: $1"
        usage
        ;;
esac
